# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# iOS specific - machine-generated files
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Podfile.lock

# iOS build artifacts
**/ios/build/
**/ios/DerivedData/

# Xcode user-specific data (don't commit!)
**/ios/**/*.xcworkspace/xcuserdata/
**/ios/**/*.xcodeproj/xcuserdata/
**/ios/**/xcuserdata/
*.xcuserstate

# Duplicate config files (from pod install issues)
**/ios/Flutter/Generated*.xcconfig
**/ios/Flutter/flutter_export_environment*.sh
**/ios/Flutter/Flutter*.podspec

# macOS specific - machine-generated files
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/macos/Flutter/Flutter-Generated.xcconfig
**/macos/Flutter/flutter_export_environment.sh

# Mac Finder duplicate files (files with " 2" in name)
**/* 2.*
**/* 2 *

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Gradle çıktısı (root /build dışında kalıyor)
android/build/
