# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must have LF line endings for Unix/macOS
*.sh text eol=lf

# iOS CI scripts specifically
ios/ci_scripts/*.sh text eol=lf

# Keep Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

